{
  "name": "motrix-turbo",
  "type": "module",
  "productName": "Motrix",
  "homepage": "https://motrix.app",
  "version": "2.0.0-beta.28",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "description": "A full-featured download manager",
  "keywords": [],
  "author": {
    "name": "Dr_rOot",
    "email": "agalwood.net@gmail.com"
  },
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "private": true,
  "scripts": {
    "ensure:electron-runtime": "node scripts/ensure-electron-runtime.mjs",
    "prestart": "pnpm run ensure:electron-runtime && node scripts/ensure-native-abi.mjs electron",
    "start": "node scripts/dev.mjs",
    "build": "pnpm run build:builtin && pnpm run build:native-host && pnpm build:electron",
    "build:electron": "pnpm run build:legal && node scripts/ensure-native-abi.mjs electron && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.worker.config.ts && vite build --config vite.renderer.config.ts",
    "stage:electron": "node scripts/stage-electron-app.mjs",
    "verify:electron-package": "node scripts/verify-electron-package.mjs",
    "smoke:electron-package": "pnpm run ensure:electron-runtime && node scripts/smoke-electron-package.mjs",
    "build:server": "pnpm run build:builtin && pnpm run build:legal && vite build --config vite.server.config.ts && vite build --config vite.worker.config.ts && vite build --config vite.renderer.web.config.ts",
    "stage:server": "node scripts/stage-server-app.mjs",
    "verify:server-package": "node scripts/verify-server-package.mjs",
    "smoke:server-package": "node scripts/smoke-server-package.mjs",
    "smoke:server-image": "node scripts/smoke-server-image.mjs",
    "measure:server-images": "node scripts/measure-server-images.mjs",
    "build:builtin": "node scripts/fetch-builtins.mjs",
    "build:native-host": "node packages/native-host/build.mjs",
    "build:legal": "pnpm run ensure:electron-runtime && node scripts/generate-third-party-notices.mjs",
    "generate:bridge-vectors": "node scripts/generate-bridge-pairing-vectors.mjs docs/bridge-pairing-protocol-vectors.json",
    "package:flatpak-native-host": "node packages/native-host/package-flatpak-companion.mjs",
    "build:snap:prepare": "node scripts/prepare-snap-project.mjs",
    "build:mac-arm64": "pnpm run build:builtin && pnpm run build:native-host -- --platform darwin --arch arm64 && pnpm run build:electron",
    "prestart:server": "node scripts/ensure-native-abi.mjs node",
    "start:server": "MOTRIX_SKIP_ELECTRON_REBUILD=1 node dist/server/index.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:file-names": "node scripts/check-file-names.mjs",
    "check:flatpak": "node scripts/verify-flatpak-packaging.mjs",
    "check:i18n": "node --import tsx scripts/check-i18n.mjs",
    "check:registry-runtime": "pnpm run ensure:electron-runtime && node scripts/check-registry-electron-runtime.mjs",
    "check:remote-extension-compatibility": "node scripts/verify-remote-extension-compatibility.mjs",
    "check:remote-extension-threats": "node scripts/verify-remote-extension-threat-evidence.mjs",
    "check:schema-parity": "node scripts/check-schema-parity.mjs",
    "check:third-party-notices": "pnpm run ensure:electron-runtime && node scripts/generate-third-party-notices.mjs --check && vitest run tests/check-third-party-notices.test.ts tests/generate-third-party-notices.test.ts",
    "check:update-artifacts": "node scripts/verify-update-artifacts.mjs",
    "check:snap": "node scripts/verify-snap-artifact.mjs",
    "check:snap-store": "node scripts/verify-snap-store-channel.mjs",
    "docs": "node scripts/obsidian-docs.mjs",
    "docs:clear": "node scripts/obsidian-docs.mjs clear",
    "docs:context": "node scripts/obsidian-docs.mjs context",
    "docs:create": "node scripts/obsidian-docs.mjs create",
    "docs:doctor": "node scripts/obsidian-docs.mjs doctor",
    "docs:list": "node scripts/obsidian-docs.mjs list",
    "docs:status": "node scripts/obsidian-docs.mjs status",
    "docs:task": "node scripts/obsidian-docs.mjs task",
    "docs:use": "node scripts/obsidian-docs.mjs use",
    "docs:check": "node scripts/obsidian-docs.mjs check",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "pretest": "node scripts/ensure-native-abi.mjs node",
    "test": "vitest run",
    "pretest:watch": "node scripts/ensure-native-abi.mjs node",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm run ensure:electron-runtime && node scripts/ensure-native-abi.mjs electron",
    "test:e2e": "playwright test",
    "test:e2e:remote-extension": "pnpm check:remote-extension-threats && playwright test --config e2e/bridge/remote-extension.playwright.config.ts",
    "test:e2e:remote-extension:soak": "node scripts/run-remote-extension-soak.mjs",
    "test:e2e:remote-extension:release-soak": "node scripts/run-remote-extension-release-soak.mjs",
    "pretest:e2e:ui": "pnpm run ensure:electron-runtime && node scripts/ensure-native-abi.mjs electron",
    "test:e2e:ui": "playwright test --ui",
    "pretest:e2e:debug": "pnpm run ensure:electron-runtime && node scripts/ensure-native-abi.mjs electron",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "postinstall": "node scripts/postinstall.mjs",
    "fetch:engine": "node scripts/fetch-engine.mjs",
    "rebuild:for-node": "pnpm rebuild better-sqlite3",
    "rebuild:for-electron": "electron-rebuild --force --only better-sqlite3",
    "pack:mac": "pnpm run check:third-party-notices && pnpm run build:mac-arm64 && pnpm run stage:electron -- --platform darwin --arch arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false pnpm exec electron-builder --mac --arm64 -c.mac.target=dir && codesign --force --deep --sign - release/mac-arm64/Motrix.app",
    "dist:mac": "pnpm run check:third-party-notices && pnpm run build:mac-arm64 && pnpm run stage:electron -- --platform darwin --arch arm64 && CSC_IDENTITY_AUTO_DISCOVERY=false pnpm exec electron-builder --mac --arm64 --publish never",
    "release:mac": "pnpm run check:third-party-notices && pnpm run build:mac-arm64 && pnpm run stage:electron -- --platform darwin --arch arm64 && pnpm exec electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@motrix/cli": "^0.4.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-spawn": "^7.0.6",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@motrix/mdxp": "^0.6.0",
    "@motrix/nat": "^0.1.1",
    "@motrix/plugin-manifest-schema": "^2.1.0",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.3",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "bittorrent-peerid": "^2.0.2",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "elkjs": "^0.12.0",
    "fastify": "^5.12.0",
    "i18next": "^26.3.6",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.31.0",
    "mmdb-lib": "^3.0.3",
    "next-themes": "^0.4.6",
    "parse-torrent": "^11.0.24",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proxy-chain": "^3.0.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "vscode-jsonrpc": "^9.0.1",
    "write-file-atomic": "^8.0.0",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "^1.1.1"
  }
}
