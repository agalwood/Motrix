{
  "manifestVersion": 1,
  "id": "test.hook-sdk-2-0",
  "name": "Legacy Hook runtime fixture",
  "version": "1.0.0",
  "description": "Legacy Hook runtime fixture compiled against the current project SDK",
  "categories": ["integration"],
  "engines": { "motrix": ">=2.0.0" },
  "main": "dist/plugin.js",
  "permissions": ["metadata", "fs.task.write", "storage"],
  "hostPermissions": ["*://*/*"],
  "activationEvents": ["onTaskType:http"],
  "contributes": {
    "hooks": {
      "beforeCreate": { "role": "enrich" },
      "beforeFinalize": { "role": "post-process" },
      "afterComplete": { "role": "audit" },
      "onError": { "role": "audit" }
    }
  }
}
