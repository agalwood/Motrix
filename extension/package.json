{
  "name": "@motrix/extension",
  "version": "0.1.19",
  "private": true,
  "description": "Official Motrix browser extension for Chrome, Microsoft Edge, and Firefox (Manifest V3)",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "imports": {
    "#build-variant-plugin": "./buildVariantPlugin.ts",
    "#build-verifier": "./scripts/verify-build.mjs",
    "#manifest-config": "./manifest.config.ts",
    "#store-release": "./scripts/store-release.mjs",
    "#store-provenance": "./scripts/verify-store-provenance.mjs",
    "#store-submitter": "./scripts/submit-store.mjs"
  },
  "scripts": {
    "check:imports": "node scripts/check-imports.mjs",
    "dev": "vite",
    "dev:firefox": "vite --mode firefox",
    "build": "pnpm run typecheck && vite build && node scripts/verify-build.mjs chromium",
    "build:chromium": "pnpm run typecheck && vite build --mode chromium && node scripts/verify-build.mjs chromium",
    "build:firefox": "pnpm run typecheck && vite build --mode firefox && node scripts/verify-build.mjs firefox",
    "build:safari": "pnpm run typecheck && vite build --mode safari && node scripts/verify-build.mjs safari",
    "safari:native": "pnpm run build:safari && node scripts/safari-native.mjs --build",
    "safari:native:signed": "pnpm run build:safari && node scripts/safari-native.mjs --build --signed",
    "build:webstore": "pnpm run typecheck && vite build --mode webstore && node scripts/verify-webstore-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm run check:browser-api && pnpm run check:browser-fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check . && pnpm check:imports",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "check:browser-api": "tsc --noEmit -p tsconfig.browser-api.json",
    "check:browser-fixtures": "tsc --noEmit -p tsconfig.browser-fixtures.json",
    "test:firefox-takeover": "node scripts/verify-firefox-takeover.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@motrix/mdxp": "^0.8.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@wxt-dev/browser": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vscode-jsonrpc": "^9.0.2",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "es-module-lexer": "3.0.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.0",
    "publish-browser-extension": "6.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.21.3"
  }
}
