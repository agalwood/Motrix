{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@core/*": ["./src/core/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@main/*": ["./src/main/*"],
      "@test-utils/*": ["./src/test-utils/*"]
    }
  },
  "include": ["src", "e2e", "*.config.ts"]
}
