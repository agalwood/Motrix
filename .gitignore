# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock
.DS_Store

# Demo
demo/

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release
/build/legal/

# Dependency directories
node_modules/
.pnpm-store/
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Local generated analysis and report artifacts
/outputs/

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Webpack
.webpack/

# Vite
.vite/
dist/
release/

# Snapcraft work directories and packages
/build/snap/.snapcraft/
/build/snap/parts/
/build/snap/prime/
/build/snap/stage/
/build/snap/*.snap

# Flatpak CI project (derived from the canonical manifest and current commit)
/flatpak/app.motrix.native.ci.yml
/flatpak/motrix-source.tar.gz

# Fetched aria2 binaries — downloaded from a pinned release at postinstall by
# scripts/fetch-engine.mjs (pinned in scripts/engine.lock.json). Never committed.
extra/*/*/aria2c
extra/*/*/aria2c.exe

# Plugin fixture bundles are pre-built and tracked — they are the "compiled"
# artifact the e2e test loads as if from a real installed plugin.
!tests/fixtures/plugins/**/dist/
!tests/fixtures/plugins/**/dist/**

# Electron-Forge
out/

# Compiled worker bundles for vitest globalSetup
dist-test/

# Codex
.codex/

# Claude Code
# Track team-shared config, ignore personal/ephemeral data
.claude/*
!.claude/rules/
!.claude/settings.json
!.claude/launch.json
.claude/settings.local.json
.claude/worktrees/
.claude/projects/
# Personal per-machine Claude instructions
CLAUDE.local.md

# Superpowers brainstorming / visual companion artifacts
.superpowers/

# Graphify outputs
# Keep only human-readable architecture report in VCS.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

.worktrees/

# Optional local Obsidian documentation gateway
/obsidian-docs.config.json
/.obsidian-doc-context.json
/.obsidian-doc-context.json.tmp-*

