{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.motrix.native",
  "productName": "Motrix",
  "copyright": "Copyright © 2026 Dr_rOot",
  "toolsets": {
    "appimage": "1.0.3"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/{better-sqlite3,bindings,file-uri-to-path}/**",
    "dist/renderer/**"
  ],
  "directories": {
    "app": "dist/electron-app",
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    ".motrix-package-stage.json",
    "dist/core/plugin/host/**",
    "dist/main/**",
    "dist/preload/**",
    "dist/renderer/**",
    "package.json",
    {
      "from": "node_modules",
      "to": "node_modules",
      "filter": [
        "**/*",
        "!**/*.map",
        "!**/*.ts",
        "!**/*.tsx",
        "!**/tsconfig*.json",
        "!**/biome.json",
        "!**/vite*.config.*"
      ]
    },
    "!**/*.map",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/tsconfig*.json",
    "!**/biome.json",
    "!**/vite*.config.*"
  ],
  "extraResources": [
    {
      "from": "./THIRD_PARTY_NOTICES.md",
      "to": "./THIRD_PARTY_NOTICES.md"
    },
    {
      "from": "./THIRD_PARTY_NOTICES.zh-CN.md",
      "to": "./THIRD_PARTY_NOTICES.zh-CN.md"
    },
    {
      "from": "./THIRD_PARTY_LICENSES",
      "to": "./THIRD_PARTY_LICENSES"
    },
    {
      "from": "./build/legal",
      "to": "./legal",
      "filter": [
        "THIRD_PARTY_DEPENDENCIES.md",
        "THIRD_PARTY_LICENSES.txt",
        "sbom.spdx.json"
      ]
    }
  ],
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": false,
    "onlyLoadAppFromAsar": true,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "grantFileProtocolExtraPrivileges": true
  },
  "protocols": [
    {
      "name": "Motrix Protocol",
      "schemes": ["motrix", "mo"]
    },
    {
      "name": "Magnet Protocol",
      "schemes": ["magnet"]
    }
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "type": "distribution",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "bundleShortVersion": "2.0.0",
    "bundleVersion": "2.0.1",
    "minimumSystemVersion": "12.0",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "darkModeSupport": true,
    "fileAssociations": [
      {
        "ext": "torrent",
        "mimeType": "application/x-bittorrent",
        "name": "Torrent",
        "role": "Viewer"
      }
    ],
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "Motrix uses the local network for UPnP port mapping and discovering download peers."
    },
    "target": ["dmg", "zip"],
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      { "from": "./extra/darwin/${arch}/", "to": "./extra/darwin/${arch}/" },
      {
        "from": "./packages/native-host/dist/darwin-${arch}/motrix-native-host",
        "to": "bin/motrix-native-host"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": [
          "mo-tray-dark-normal@1x.png",
          "mo-tray-dark-normal@2x.png",
          "tray.svg",
          "resvg.wasm",
          "SFNS-Regular.ttf"
        ]
      }
    ]
  },
  "dmg": {
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 410, "y": 230, "type": "link", "path": "/Applications" },
      { "x": 130, "y": 230, "type": "file" }
    ]
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "zip", "arch": ["x64"] }
    ],
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      { "from": "./extra/win32/${arch}/", "to": "./extra/win32/${arch}/" },
      {
        "from": "./packages/native-host/dist/win32-${arch}/motrix-native-host.exe",
        "to": "bin/motrix-native-host.exe"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": ["mo-tray-colorful-*.ico"]
      }
    ]
  },
  "nsis": {
    "include": "build/installer.nsh",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "perMachine": false
  },
  "linux": {
    "executableName": "motrix",
    "category": "Network",
    "synopsis": "Full-featured download manager",
    "description": "Motrix is a full-featured download manager that supports HTTP, FTP, BitTorrent and Magnet downloads.",
    "fileAssociations": [
      {
        "ext": "torrent",
        "mimeType": "application/x-bittorrent",
        "name": "Torrent",
        "role": "Viewer"
      }
    ],
    "mimeTypes": [
      "application/x-bittorrent",
      "x-scheme-handler/magnet",
      "x-scheme-handler/motrix"
    ],
    "desktop": {
      "entry": {
        "Name": "Motrix",
        "GenericName": "Download Manager",
        "Comment": "Full-featured download manager",
        "Keywords": "download;bittorrent;magnet;aria2;",
        "MimeType": "application/x-bittorrent;x-scheme-handler/magnet;x-scheme-handler/motrix;",
        "StartupWMClass": "Motrix"
      }
    },
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] },
      { "target": "rpm", "arch": ["x64", "arm64"] }
    ],
    "extraResources": [
      { "from": "./extra/aria2.conf", "to": "./extra/aria2.conf" },
      { "from": "./dist/builtin-plugins", "to": "./builtin-plugins" },
      {
        "from": "./build/256x256.png",
        "to": "./icons/motrix-appimage-256.png"
      },
      { "from": "./extra/linux/${arch}/", "to": "./extra/linux/${arch}/" },
      {
        "from": "./packages/native-host/dist/linux-${arch}/motrix-native-host",
        "to": "bin/motrix-native-host"
      },
      {
        "from": "./extra/tray/",
        "to": "./extra/tray/",
        "filter": [
          "mo-tray-dark-normal@1x.png",
          "mo-tray-dark-normal@2x.png",
          "mo-tray-dark-active@1x.png",
          "mo-tray-dark-active@2x.png",
          "mo-tray-light-normal@1x.png",
          "mo-tray-light-normal@2x.png",
          "mo-tray-light-active@1x.png",
          "mo-tray-light-active@2x.png"
        ]
      }
    ]
  },
  "appImage": {
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "deb": {
    "artifactName": "${productName}_${version}_${arch}.${ext}"
  },
  "rpm": {
    "artifactName": "${productName}-${version}.${arch}.${ext}"
  },
  "beforePack": "./scripts/before-pack-verify.mjs",
  "beforeBuild": "./scripts/before-build-use-staged-dependencies.mjs",
  "artifactBuildCompleted": "./scripts/finalize-appimage-artifact.mjs",
  "detectUpdateChannel": true,
  "generateUpdatesFilesForAllChannels": true,
  "publish": {
    "provider": "generic",
    "url": "https://dl.motrix.app/releases/"
  }
}
